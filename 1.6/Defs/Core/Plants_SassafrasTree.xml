<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       SASSAFRAS TREE
       Extends DeciduousTreeBase. Normal tree growth rules.
       Chopping produces RP_ChoppedStumpSassafras.
       Spawns in biomes via XPath patches (Patches_Biomes.xml).
       Design Decision #16: vanilla systems only, no custom C#.
       ============================================================ -->

  <ThingDef ParentName="DeciduousTreeBase">
    <defName>RP_Plant_TreeSassafras</defName>
    <label>sassafras tree</label>
    <description>A medium-sized deciduous tree with distinctive mitten-shaped leaves and aromatic bark. The roots and bark contain safrole, a volatile oil that serves as the precursor to fluff. The oil is best extracted from the stump after felling.\n\nSassafras trees grow naturally in temperate and tropical forests. They cannot be planted by colonists.</description>
    <graphicData>
      <texPath>Things/Plant/RP_TreeSassafras</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.18, 0.3, 0.15)</volume>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Nutrition>1.25</Nutrition>
    </statBases>
    <plant>
      <growDays>30</growDays>
      <harvestWork>550</harvestWork>
      <harvestYield>25</harvestYield>
      <choppedThingDef>RP_ChoppedStumpSassafras</choppedThingDef>
      <visualSizeRange>1.3~2.8</visualSizeRange>
      <topWindExposure>0.25</topWindExposure>
      <wildClusterRadius>-1</wildClusterRadius>
    </plant>
  </ThingDef>

  <!-- ============================================================
       CHOPPED SASSAFRAS STUMP
       Extends StumpBase. High deterioration rate (50).
       Harvestable for safrole (yield 12).
       Smashing the stump yields wood, not safrole.
       ============================================================ -->

  <ThingDef ParentName="StumpBase">
    <defName>RP_ChoppedStumpSassafras</defName>
    <label>chopped sassafras stump</label>
    <description>The fresh stump of a felled sassafras tree. The exposed roots and inner bark are rich with safrole oil, which can be carefully extracted. If left unattended, the volatile oil evaporates quickly and the stump becomes worthless.\n\nExtract the safrole before the stump deteriorates. Smashing the stump yields only wood.</description>
    <graphicData>
      <texPath>Things/Plant/RP_StumpSassafras</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <DeteriorationRate>50</DeteriorationRate>
    </statBases>
    <plant>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RP_Safrole</harvestedThingDef>
      <harvestYield>12</harvestYield>
      <harvestWork>400</harvestWork>
    </plant>
  </ThingDef>

</Defs>
