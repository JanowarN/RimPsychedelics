<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       RESEARCH TAB
       Own tab for mod compatibility. Keeps RP research separate
       from vanilla and other mod research trees.
       ============================================================ -->

  <ResearchTabDef>
    <defName>RP_ResearchTab</defName>
    <label>Psychedelic Drugs</label>
  </ResearchTabDef>

  <!-- ============================================================
       RESEARCH PROJECTS
       Three projects unlocking the production chains.
       Mindcap is standalone Neolithic. LYS and Fluff branch
       off vanilla DrugProduction (Industrial).
       All on the RP_ResearchTab custom tab.
       ============================================================ -->

  <!-- ============================================================
       1. MINDCAP PREPARATION
       Neolithic tier. No prerequisites. Unlocks:
       - Recipe: dry mindcap mushrooms
       (The mindcap plant itself is sowable from game start — research
        only gates the drying recipe, not cultivation.)
       ============================================================ -->
  <ResearchProjectDef>
    <defName>RP_MindcapPreparation</defName>
    <label>mindcap preparation</label>
    <description>Dry raw mindcap mushrooms to neutralize their natural toxins while preserving psychoactive compounds. Mindcap is a powerful psychedelic capable of creating life-altering experiences.</description>
    <baseCost>600</baseCost>
    <techLevel>Neolithic</techLevel>
    <tab>RP_ResearchTab</tab>
    <researchViewX>0.00</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

  <!-- ============================================================
       2. ERGO CULTIVATION
       Neolithic tier. No prerequisites. Unlocks:
       - Sowing RP_Plant_Ergo
       Required by: RP_LYSSynthesis (alongside DrugProduction).
       ============================================================ -->
  <ResearchProjectDef>
    <defName>RP_ErgoCultivation</defName>
    <label>ergo cultivation</label>
    <description>Cultivate the bioengineered ergo plant. Ergo pods are the key precursor for synthesizing LYS.</description>
    <baseCost>800</baseCost>
    <techLevel>Neolithic</techLevel>
    <tab>RP_ResearchTab</tab>
    <researchViewX>0.00</researchViewX>
    <researchViewY>3.00</researchViewY>
  </ResearchProjectDef>

  <!-- ============================================================
       3. LYS SYNTHESIS
       Industrial tier. Prerequisites: DrugProduction + RP_ErgoCultivation.
       Unlocks:
       - Recipe: synthesize LYS
       ============================================================ -->
  <ResearchProjectDef>
    <defName>RP_LYSSynthesis</defName>
    <label>LYS synthesis</label>
    <description>Synthesize LYS from the ergoloids in ergo pods and neutroamine. Requiring a skilled chemist and a properly equipped drug lab, the result is one of the most effective psychedelics in the known verse.</description>
    <baseCost>4000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>RP_ResearchTab</tab>
    <prerequisites>
      <li>DrugProduction</li>
      <li>RP_ErgoCultivation</li>
    </prerequisites>
    <researchViewX>2.00</researchViewX>
    <researchViewY>3.00</researchViewY>
  </ResearchProjectDef>

  <!-- ============================================================
       4. FLUFF SYNTHESIS
       Industrial tier. Prerequisite: DrugProduction.
       Unlocks:
       - Recipe: synthesize fluff
       (Sassafras trees grow wild and don't need research to chop.
        Stump harvesting for safrole is available without research.)
       ============================================================ -->
  <ResearchProjectDef>
    <defName>RP_FluffSynthesis</defName>
    <label>fluff synthesis</label>
    <description>Synthesize fluff from safrole oil. Fluff is a non-addictive empathogenic drug that provides large mood boosts and analgesic effects, but with a harsh backlash the day after.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>RP_ResearchTab</tab>
    <prerequisites>
      <li>DrugProduction</li>
    </prerequisites>
    <researchViewX>2.00</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

</Defs>
