<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       RP_RecentTrip
       Invisible 15-day memory thought applied at resolution.
       Zero mood effect. Exists solely as a flag for the Ideology
       Essential precept ("haven't tripped recently" checks for
       the absence of this thought).
       ============================================================ -->
  <ThoughtDef>
    <defName>RP_RecentTrip</defName>
    <durationDays>15</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>recent trip</label>
        <description>Placeholder description for RP_RecentTrip.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ============================================================
       RP_SharedTripMemory
       Social opinion thought. Active when a RP_SharedTrip tale
       exists between two pawns. Gated behind VSIE being active.
       ============================================================ -->
  <ThoughtDef>
    <defName>RP_SharedTripMemory</defName>
    <thoughtClass>RimPsychedelics.Thought_SharedTrip</thoughtClass>
    <workerClass>RimPsychedelics.ThoughtWorker_SharedTrip</workerClass>
    <taleDef>RP_SharedTrip</taleDef>
    <stages>
      <li>
        <label>shared a trip</label>
        <description>We tripped together. There's a bond in that — something unspoken.</description>
        <baseOpinionOffset>15</baseOpinionOffset>
      </li>
    </stages>
    <modExtensions>
      <li Class="RimPsychedelics.TaleFadeExtension">
        <falloffDays>30</falloffDays>
        <minimumOpinionOffset>5</minimumOpinionOffset>
      </li>
    </modExtensions>
  </ThoughtDef>

</Defs>
