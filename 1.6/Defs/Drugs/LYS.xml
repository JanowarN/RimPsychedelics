<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       1. CHEMICAL FOUNDATION
       ============================================================ -->

  <ChemicalDef>
    <defName>RP_ChemicalLYS</defName>
    <label>LYS</label>
    <addictionHediff>RP_LYSAddictionDummy</addictionHediff>
    <toleranceHediff>RP_LYSTolerance</toleranceHediff>
    <onGeneratedAddictedToleranceChance>0.0</onGeneratedAddictedToleranceChance>
  </ChemicalDef>

  <!-- Dummy addiction: clears instantly, never visible to player.
       Uses Hediff_Addiction directly, NOT ParentName="AddictionBase". -->
  <HediffDef>
    <defName>RP_LYSAddictionDummy</defName>
    <hediffClass>Hediff_Addiction</hediffClass>
    <label>LYS tolerance response</label>
    <description>A chemical addiction to LYS. They designed this drug for that to be impossible... How did this even happen to you?</description>
    <maxSeverity>0.01</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <!-- Tolerance: standard severity-over-time tracker.
       Decay rate -0.10/day → ~5 days below 50%, ~10 days to zero. -->
  <HediffDef>
    <defName>RP_LYSTolerance</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>LYS tolerance</label>
    <description>Tolerance from taking LYS recently. LYS will be less effective until this tolerance wears off. Taking more at high tolerance is... ill advised.</description>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.10</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <!-- ============================================================
       2. COME-UP HEDIFF
       ~3.5 hours at base rate. Severity rises 0 → 1.0.
       Custom hediff class handles severity cap and peak transition.
       ============================================================ -->

  <HediffDef>
    <defName>RP_LYSComeUp</defName>
    <hediffClass>RimPsychedelics.Hediff_PsychedelicComeUp</hediffClass>
    <label>LYS come-up</label>
    <description>Coming up after taking a dose of LYS. Typically includes mild discomfort that fades as the trip begins.</description>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>6.857</severityPerDay>
      </li>
    </comps>
    <stages>

      <!-- Stage 1: "waiting" — minSeverity 0.0, ~45 min -->
      <li>
        <label>waiting</label>
        <minSeverity>0.0</minSeverity>
      </li>

      <!-- Stage 2: "unsettled" — minSeverity 0.21, ~1.5 hr -->
      <li>
        <label>on-set</label>
        <minSeverity>0.21</minSeverity>
        <vomitMtbDays>5</vomitMtbDays>
        <hungerRateFactor>0.5</hungerRateFactor>
        <restFallFactor>0.3</restFallFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
          <li><capacity>Moving</capacity><offset>-0.15</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>-0.03</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.10</offset></li>
          <li><capacity>Breathing</capacity><offset>0.07</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.07</offset></li>
        </capMods>
      </li>

      <!-- Stage 3: "ascending" — minSeverity 0.64, ~1.25 hr -->
      <li>
        <label>intensifying</label>
        <minSeverity>0.64</minSeverity>
        <vomitMtbDays>8</vomitMtbDays>
        <painFactor>0.3</painFactor>
        <hungerRateFactor>0.3</hungerRateFactor>
        <restFallFactor>0.15</restFallFactor>
        <socialFightChanceFactor>0.5</socialFightChanceFactor>
        <forgetMemoryThoughtMtbDays>5</forgetMemoryThoughtMtbDays>
        <pctConditionalThoughtsNullified>0.25</pctConditionalThoughtsNullified>
        <opinionOfOthersFactor>1.5</opinionOfOthersFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.12</offset></li>
          <li><capacity>Moving</capacity><offset>-0.25</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>-0.07</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.20</offset></li>
          <li><capacity>Breathing</capacity><offset>0.13</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.13</offset></li>
          <li><capacity>Sight</capacity><offset>-0.30</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.15</offset></li>
          <li><capacity>Talking</capacity><offset>-0.10</offset></li>
          <li><capacity>Hearing</capacity><offset>-0.20</offset></li>
        </capMods>
      </li>

    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>RP_LYSComeUpMood</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>RP_LYSComeUp</hediff>
    <stages>
      <!-- Waiting -->
      <li>
        <label>Dosed LYS</label>
        <description>I'm looking forward to this.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <!-- Unsettled -->
      <li>
        <label>LYS onset</label>
        <description>My body feels weird and I'm a bit anxious.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <!-- Ascending -->
      <li>
        <label>Coming up</label>
        <description>I'll see you on the dark side of the moon.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ============================================================
       3. GOOD PEAK HEDIFF
       ~16.5 hours. Severity decays 1.0 → 0.
       Shared physical effects + good-trip mood/social.
       ============================================================ -->

