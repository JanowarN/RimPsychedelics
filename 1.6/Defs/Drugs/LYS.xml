  <ThoughtDef>
    <defName>RP_LYSTripGoodMood</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>RP_LYSTripGood</hediff>
    <stages>
      <!-- Fading -->
      <li>
        <label>Coming down</label>
        <description>Everything's as it should be.</description>
        <baseMoodEffect>25</baseMoodEffect>
      </li>
      <!-- Easing -->
      <li>
        <label>Tripping on LYS</label>
        <description>Oh... I'm a person again. That's kind of nice actually.</description>
        <baseMoodEffect>30</baseMoodEffect>
      </li>
      <!-- Plateau -->
      <li>
        <label>Tripping on LYS</label>
        <description>I can feel my thoughts before I think them, like waves forming before they break.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <!-- Peaking -->
      <li>
        <label>Tripping on LYS</label>
        <description>I'm not having an experience, I'm the experience that was pretending to be had by someone.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

