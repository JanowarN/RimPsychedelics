        <opinionOfOthersFactor>1.0</opinionOfOthersFactor>
      </li>

      <!-- Unsettled — minSeverity 0.50, ~1 day -->
      <li>
        <label>unsettled</label>
        <minSeverity>0.50</minSeverity>
        <socialFightChanceFactor>1.2</socialFightChanceFactor>
        <opinionOfOthersFactor>0.8</opinionOfOthersFactor>
      </li>

      <!-- Shaken — minSeverity 0.83, ~0.5 days -->
      <li>
        <label>shaken</label>
        <minSeverity>0.83</minSeverity>
        <socialFightChanceFactor>1.5</socialFightChanceFactor>
        <opinionOfOthersFactor>0.6</opinionOfOthersFactor>
      </li>

    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>RP_LYSDisturbedMood</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>RP_LYSDisturbed</hediff>
    <stages>
      <!-- Fading -->
      <li>
        <label>Bad LYS trip</label>
        <description>I think I'm going to be okay.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
      <!-- Unsettled -->
      <li>
        <label>Bad LYS trip</label>
        <description>Everything is returning to normal, but I'm still anxious.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <!-- Shaken -->
      <li>
        <label>Bad LYS trip</label>
        <description>I feel off and isolated.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ============================================================
       7. DRUG THINGDEF
       ============================================================ -->

  <ThingDef ParentName="MakeableDrugBase">
    <defName>RP_LYS</defName>
    <label>LYS</label>
    <description>A powerful psychedelic drug that was designed during the third greate wave of colonization along with the bioengineered plant ergo. An amalgam of multiple entheogens, subjective effects include open and closed-eye visuals, time distortion, enhanced introspection, ego loss, and euphoria. LYS is commonly reported to be able to evoke mystical-type experiences that can facilitate self-reflection and personal growth.</description>
    <graphicData>
      <texPath>Things/Item/Drug/RP_LYS</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <socialPropernessMatters>false</socialPropernessMatters>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToMake>600</WorkToMake>
      <MarketValue>36</MarketValue>
      <Mass>0.005</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <techLevel>Industrial</techLevel>
    <ingestible>
      <joyKind>Chemical</joyKind>
      <joy>1.0</joy>
      <drugCategory>Hard</drugCategory>
      <baseIngestTicks>60</baseIngestTicks>
      <outcomeDoers>
        <!-- RP custom doer: reads extension, handles tolerance check,
             valence roll, and come-up hediff application.
             Must be BEFORE vanilla tolerance doer. -->
        <li Class="RimPsychedelics.PsychedelicIngestionOutcomeDoer">
          <toleranceChemical>RP_ChemicalLYS</toleranceChemical>
        </li>
        <!-- Vanilla doer: applies tolerance severity.
             RP reads tolerance but does not apply it. -->
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>RP_LYSTolerance</hediffDef>
          <severity>1.0</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>RP_ChemicalLYS</chemical>
        <addictiveness>0.0</addictiveness>
        <minToleranceToAddict>9999.0</minToleranceToAddict>
        <existingAddictionSeverityOffset>0</existingAddictionSeverityOffset>
        <needLevelOffset>0</needLevelOffset>
        <listOrder>2000</listOrder>
      </li>
    </comps>

    <!-- ============================================================
         PSYCHEDELIC DRUG EXTENSION — Single source of truth
         ============================================================ -->
    <modExtensions>
      <li Class="RimPsychedelics.PsychedelicDrugExtension">

        <!-- Hediff references -->
        <hediffDefComeUp>RP_LYSComeUp</hediffDefComeUp>
        <hediffDefPositiveTrip>RP_LYSTripGood</hediffDefPositiveTrip>
        <hediffDefNegativeTrip>RP_LYSTripBad</hediffDefNegativeTrip>
        <hediffDefPositiveResolution>RP_LYSAfterglow</hediffDefPositiveResolution>
        <hediffDefNegativeResolution>RP_LYSDisturbed</hediffDefNegativeResolution>

        <!-- Tolerance -->
        <toleranceChemical>RP_ChemicalLYS</toleranceChemical>
        <noTripToleranceThreshold>0.5</noTripToleranceThreshold>

        <!-- Psychonaut progression -->
        <psychonautExperienceGain>0.1</psychonautExperienceGain>
        <countsPsychonautExperience>true</countsPsychonautExperience>

        <!-- Valence curves — normal pawn -->
        <goodTripChanceAtZeroMood>0.10</goodTripChanceAtZeroMood>
        <goodTripChanceUpperLimit>0.90</goodTripChanceUpperLimit>
        <goodTripTransitionPoint>0.50</goodTripTransitionPoint>
        <goodTripPlateauPoint>0.80</goodTripPlateauPoint>

        <!-- Valence curves — Psychonaut -->
        <psychonautGoodTripChanceAtZeroMood>0.20</psychonautGoodTripChanceAtZeroMood>
        <psychonautGoodTripChanceUpperLimit>0.95</psychonautGoodTripChanceUpperLimit>
        <psychonautGoodTripTransitionPoint>0.30</psychonautGoodTripTransitionPoint>
        <psychonautGoodTripPlateauPoint>0.55</psychonautGoodTripPlateauPoint>

        <!-- Ritual bonus -->
        <ritualGoodTripChanceBonus>0.15</ritualGoodTripChanceBonus>

        <!-- Inspiration -->
        <canGoodTripInspire>true</canGoodTripInspire>
        <canBadTripInspire>false</canBadTripInspire>
        <inspirationChance>0.15</inspirationChance>

        <!-- Trait modification -->
        <canModifyTraits>true</canModifyTraits>
        <traitChangeChance>0.10</traitChangeChance>
        <traitChangeChancePsychonaut>0.01</traitChangeChancePsychonaut>

        <!-- Trait pool — Spectrums -->
        <traitSpectrums>
          <li>
            <traitDef>NaturalMood</traitDef>
            <minDegree>-2</minDegree>
            <maxDegree>2</maxDegree>
            <selectionWeight>1.2</selectionWeight>
            <goodTripBias>0.7</goodTripBias>
            <badTripBias>-0.7</badTripBias>
            <higherMessage>[PAWN_nameDef] has started to look on the brighter side of life as a result of a [DRUG_label] trip.</higherMessage>
            <lowerMessage>[PAWN_nameDef] sees the world a little darker after an intense [DRUG_label] experience.</lowerMessage>
          </li>
          <li>
            <traitDef>Nerves</traitDef>
            <minDegree>-1</minDegree>
            <maxDegree>2</maxDegree>
            <selectionWeight>1.0</selectionWeight>
            <goodTripBias>0.6</goodTripBias>
            <badTripBias>-0.7</badTripBias>
            <higherMessage>A [DRUG_label] trip led to [PAWN_nameDef] having a newfound will to push through under stress.</higherMessage>
            <lowerMessage>[PAWN_nameDef]'s self-confidence was shaken by an experience on [DRUG_label], making stress harder for [PAWN_objective] to manage.</lowerMessage>
          </li>
          <li>
            <traitDef>Neurotic</traitDef>
            <minDegree>0</minDegree>
            <maxDegree>2</maxDegree>
            <selectionWeight>0.6</selectionWeight>
            <goodTripBias>-0.7</goodTripBias>
            <badTripBias>0.5</badTripBias>
            <higherMessage>A [DRUG_label] experience has left [PAWN_nameDef] with hightened anxiety if anything isn't fully squared away.</higherMessage>
            <lowerMessage>[PAWN_nameDef] is learning to let go of trying to control [PAWN_possessive] surroundings as much after a [DRUG_label]-assisted reframing.</lowerMessage>
          </li>
          <li>
            <traitDef>DrugDesire</traitDef>
            <minDegree>-1</minDegree>
            <maxDegree>2</maxDegree>
            <selectionWeight>0.5</selectionWeight>
            <goodTripBias>0.3</goodTripBias>
            <badTripBias>-0.8</badTripBias>
            <higherMessage>[PAWN_nameDef] had an experience on [DRUG_label] that caused [PAWN_possessive] to want to explore altered states more.</higherMessage>
            <lowerMessage>[PAWN_nameDef] had an experience on [DRUG_label] that caused [PAWN_possessive] to be less interested in future pharmacologically mediated mind states.</lowerMessage>
          </li>
          <li>
            <traitDef>PsychicSensitivity</traitDef>
            <minDegree>-1</minDegree>
            <maxDegree>1</maxDegree>
            <selectionWeight>0.3</selectionWeight>
            <goodTripBias>0.4</goodTripBias>
            <badTripBias>0.0</badTripBias>
            <higherMessage>[PAWN_nameDef] has permanently become more psychically sensitive after [PAWN_possessive] mind opened to new understanding of the connection of all things.</higherMessage>
            <lowerMessage>[PAWN_nameDef] has become permanently more closed off psychically after having a visceral experience of dangerous psychic forces while on a [DRUG_label] trip.</lowerMessage>
          </li>
        </traitSpectrums>

        <!-- Trait pool — Standalones -->
        <traitStandalones>
          <li>
            <traitDef>Kind</traitDef>
            <degree>0</degree>
            <selectionWeight>0.8</selectionWeight>
            <goodTripBias>1.0</goodTripBias>
            <badTripBias>-0.6</badTripBias>
            <addedMessage>[PAWN_nameDef] had a profound experience understanding how they treat others, and has commited to being more [TRAIT_label].</addedMessage>
            <removedMessage>After a [DRUG_label] experience, [PAWN_nameDef] is no longer sure if being so [TRAIT_label] is the best way to live.</removedMessage>
          </li>
          <li>
            <traitDef>Abrasive</traitDef>
            <degree>0</degree>
            <selectionWeight>0.5</selectionWeight>
            <goodTripBias>-0.8</goodTripBias>
            <badTripBias>1.0</badTripBias>
            <addedMessage>[PAWN_nameDef] has started to seem [TRAIT_label] after a [DRUG_label] trip shattered their perception of social niceties.</addedMessage>
            <removedMessage>[PAWN_nameDef] had a profound experience understanding how they treat others, and will no longer be so [TRAIT_label].</removedMessage>
          </li>
          <li>
            <traitDef>Nudist</traitDef>
            <degree>0</degree>
            <selectionWeight>0.15</selectionWeight>
            <goodTripBias>0.6</goodTripBias>
            <badTripBias>-0.3</badTripBias>
            <addedMessage>[PAWN_nameDef] has decided to become [TRAIT_label] after a [DRUG_label] trip changed [PAWN_possessive] relationship to [PAWN_possessive] own body.</addedMessage>
            <removedMessage>[PAWN_nameDef] has abandoned nudism after gaining new perspective while on [DRUG_label].</removedMessage>
          </li>
          <li>
            <traitDef>Ascetic</traitDef>
            <degree>0</degree>
            <selectionWeight>0.4</selectionWeight>
            <goodTripBias>0.8</goodTripBias>
            <badTripBias>0.4</badTripBias>
            <addedMessage>After a revelation on [DRUG_label], [PAWN_nameDef] has devoted themselves to a particular path of spiritual growth, and had become [TRAIT_label].</addedMessage>
            <removedMessage>A [DRUG_label] experience has led [PAWN_nameDef] to reconsider physical comforts, and [PAWN_possessive] is not longer [TRAIT_label].</removedMessage>
          </li>
          <li>
            <traitDef>BodyPurist</traitDef>
            <degree>0</degree>
            <selectionWeight>0.3</selectionWeight>
            <goodTripBias>0.7</goodTripBias>
            <badTripBias>0.6</badTripBias>
            <addedMessage>[PAWN_nameDef] has developed a strong aversion to body modification after an experience on [DRUG_label].</addedMessage>
            <removedMessage>[PAWN_nameDef]'s feelings on body modification have mellowed after a revelation on [DRUG_label].</removedMessage>
          </li>
          <li>
            <traitDef>Transhumanist</traitDef>
            <degree>0</degree>
            <selectionWeight>0.3</selectionWeight>
            <goodTripBias>0.6</goodTripBias>
            <badTripBias>0.0</badTripBias>
            <addedMessage>While tripping on [DRUG_label], [PAWN_nameDef] had a profound sense of the limitations of flesh and has become [TRAIT_label].</addedMessage>
            <removedMessage>[PAWN_nameDef]'s conviction in their [TRAIT_label] beliefs was shaken by a [DRUG_label] trip.</removedMessage>
          </li>
        </traitStandalones>

      </li>
    </modExtensions>
  </ThingDef>

  <!-- LYS has no social ThoughtDefs. -->

</Defs>
