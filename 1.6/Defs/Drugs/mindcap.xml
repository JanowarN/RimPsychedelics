<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       1. CHEMICAL FOUNDATION
       ============================================================ -->

  <ChemicalDef>
    <defName>RP_ChemicalMindcap</defName>
    <label>mindcap</label>
    <addictionHediff>RP_MindcapAddictionDummy</addictionHediff>
    <toleranceHediff>RP_MindcapTolerance</toleranceHediff>
    <onGeneratedAddictedToleranceChance>0.0</onGeneratedAddictedToleranceChance>
  </ChemicalDef>

  <HediffDef>
    <defName>RP_MindcapAddictionDummy</defName>
    <hediffClass>Hediff_Addiction</hediffClass>
    <label>mindcap tolerance response</label>
    <description>Placeholder description for RP_MindcapAddictionDummy.</description>
    <maxSeverity>0.01</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>RP_MindcapTolerance</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>mindcap tolerance</label>
    <description>Placeholder description for RP_MindcapTolerance.</description>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.10</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <!-- ============================================================
       2. COME-UP HEDIFF
       ~1 hour at base rate. Severity rises 0 → 1.0.
       ============================================================ -->

  <HediffDef>
    <defName>RP_MindcapComeUp</defName>
    <hediffClass>RimPsychedelics.Hediff_PsychedelicComeUp</hediffClass>
    <label>mindcap come-up</label>
    <description>Coming up after taking a dose of mindcap. Typically characterized by heavy nausea and physical discomfort that abates somewhat once the peak hits.</description>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>24.0</severityPerDay>
      </li>
    </comps>
    <stages>

      <!-- Stage 1: "waiting" — minSeverity 0.0, ~20 min -->
      <li>
        <label>waiting</label>
        <minSeverity>0.0</minSeverity>
      </li>

      <!-- Stage 2: "hitting" — minSeverity 0.33, ~40 min -->
      <li>
        <label>on-set</label>
        <minSeverity>0.33</minSeverity>
        <vomitMtbDays>0.25</vomitMtbDays>
        <hungerRateFactor>0.4</hungerRateFactor>
        <restFallFactor>0.2</restFallFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.08</offset></li>
          <li><capacity>Moving</capacity><offset>-0.20</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>-0.05</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.15</offset></li>
          <li><capacity>Breathing</capacity><offset>0.10</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.10</offset></li>
          <li><capacity>Sight</capacity><offset>-0.15</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.08</offset></li>
          <li><capacity>Talking</capacity><offset>-0.05</offset></li>
          <li><capacity>Hearing</capacity><offset>-0.10</offset></li>
        </capMods>
      </li>

    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>RP_MindcapComeUpMood</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>RP_MindcapComeUp</hediff>
    <stages>
      <!-- Waiting -->
      <li>
        <label>Dosed mindcap</label>
        <description>I'm looking forward to this.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <!-- Hitting -->
      <li>
        <label>Coming up</label>
        <description>I feel very sick and everything is moving.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ============================================================
       3. GOOD PEAK HEDIFF
       ~7 hours. Severity decays 1.0 → 0.
       Shared physical effects + good-trip mood/social.
       More nausea than LYS (persists through plateau).
       ============================================================ -->

  <HediffDef>
    <defName>RP_MindcapTripGood</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>mindcap trip</label>
    <description>Tripping on mindcap. Characterized by radically altered mental state, significant impairment of most basic activity, and some lingering nausea. Can be a very impactful positive or negative experience depending on set and setting, with extended mood impacts after coming down.</description>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-3.4286</severityPerDay>
      </li>
      <li Class="RimPsychedelics.HediffCompProperties_TripResolution">
        <drugDef>RP_Mindcap</drugDef>
      </li>
    </comps>
    <stages>

      <!-- Fading — minSeverity 0.0, ~1.5 hr -->
      <li>
        <label>coming down</label>
        <minSeverity>0.0</minSeverity>
        <painFactor>0.75</painFactor>
        <hungerRateFactor>0.75</hungerRateFactor>
        <restFallFactor>0.5</restFallFactor>
        <forgetMemoryThoughtMtbDays>10</forgetMemoryThoughtMtbDays>
        <pctConditionalThoughtsNullified>0.15</pctConditionalThoughtsNullified>
        <socialFightChanceFactor>0.3</socialFightChanceFactor>
        <opinionOfOthersFactor>1.5</opinionOfOthersFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
          <li><capacity>Sight</capacity><offset>-0.15</offset></li>
          <li><capacity>Moving</capacity><offset>-0.10</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.07</offset></li>
          <li><capacity>Talking</capacity><offset>-0.05</offset></li>
          <li><capacity>Hearing</capacity><offset>-0.10</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>-0.03</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.07</offset></li>
          <li><capacity>Breathing</capacity><offset>0.05</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.05</offset></li>
        </capMods>
      </li>

      <!-- Easing — minSeverity 0.21, ~2 hr -->
      <li>
        <label>coming down</label>
        <minSeverity>0.21</minSeverity>
        <painFactor>0.6</painFactor>
        <hungerRateFactor>0.5</hungerRateFactor>
        <restFallFactor>0.25</restFallFactor>
        <vomitMtbDays>3.0</vomitMtbDays>
        <forgetMemoryThoughtMtbDays>6</forgetMemoryThoughtMtbDays>
        <pctConditionalThoughtsNullified>0.35</pctConditionalThoughtsNullified>
        <socialFightChanceFactor>0</socialFightChanceFactor>
        <opinionOfOthersFactor>2.0</opinionOfOthersFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.10</offset></li>
          <li><capacity>Sight</capacity><offset>-0.30</offset></li>
          <li><capacity>Moving</capacity><offset>-0.20</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.15</offset></li>
          <li><capacity>Talking</capacity><offset>-0.10</offset></li>
          <li><capacity>Hearing</capacity><offset>-0.20</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>-0.05</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.15</offset></li>
          <li><capacity>Breathing</capacity><offset>0.10</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.10</offset></li>
        </capMods>
      </li>

      <!-- Plateau — minSeverity 0.50, ~2 hr -->
      <li>
        <label>plateau</label>
        <minSeverity>0.50</minSeverity>
        <painFactor>0.45</painFactor>
        <hungerRateFactor>0.1</hungerRateFactor>
        <restFallFactor>0.05</restFallFactor>
        <vomitMtbDays>1.0</vomitMtbDays>
        <forgetMemoryThoughtMtbDays>4</forgetMemoryThoughtMtbDays>
        <pctConditionalThoughtsNullified>0.75</pctConditionalThoughtsNullified>
        <socialFightChanceFactor>0</socialFightChanceFactor>
        <opinionOfOthersFactor>3.0</opinionOfOthersFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.17</offset><setMax>0.85</setMax></li>
          <li><capacity>Sight</capacity><offset>-0.50</offset></li>
          <li><capacity>Moving</capacity><offset>-0.35</offset><setMax>0.75</setMax></li>
          <li><capacity>Manipulation</capacity><offset>-0.25</offset></li>
          <li><capacity>Talking</capacity><offset>-0.17</offset></li>
          <li><capacity>Hearing</capacity><offset>-0.35</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>-0.08</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.25</offset></li>
          <li><capacity>Breathing</capacity><offset>0.17</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.17</offset></li>
        </capMods>
      </li>

      <!-- Peaking — minSeverity 0.79, ~1.5 hr -->
      <li>
        <label>peak</label>
        <minSeverity>0.79</minSeverity>
        <vomitMtbDays>0.5</vomitMtbDays>
        <painFactor>0.4</painFactor>
        <hungerRateFactor>0.1</hungerRateFactor>
        <restFallFactor>0.05</restFallFactor>
        <forgetMemoryThoughtMtbDays>3</forgetMemoryThoughtMtbDays>
        <pctConditionalThoughtsNullified>0.75</pctConditionalThoughtsNullified>
        <socialFightChanceFactor>0</socialFightChanceFactor>
        <opinionOfOthersFactor>2.5</opinionOfOthersFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.20</offset><setMax>0.80</setMax></li>
          <li><capacity>Sight</capacity><offset>-0.60</offset></li>
          <li><capacity>Moving</capacity><offset>-0.40</offset><setMax>0.70</setMax></li>
          <li><capacity>Manipulation</capacity><offset>-0.30</offset></li>
          <li><capacity>Talking</capacity><offset>-0.20</offset></li>
          <li><capacity>Hearing</capacity><offset>-0.40</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>-0.10</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.30</offset></li>
          <li><capacity>Breathing</capacity><offset>0.20</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.20</offset></li>
        </capMods>
      </li>

    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>RP_MindcapTripGoodMood</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>RP_MindcapTripGood</hediff>
    <stages>
      <!-- Fading -->
      <li>
        <label>Coming down</label>
        <description>Everything looks the same as before but it's like someone cleaned the glass I was looking through.</description>
        <baseMoodEffect>20</baseMoodEffect>
      </li>
      <!-- Easing -->
      <li>
        <label>Tripping on mindcap</label>
        <description>I feel like I just got back from somewhere I'll never be able to fully explain.</description>
        <baseMoodEffect>25</baseMoodEffect>
      </li>
      <!-- Plateau -->
      <li>
        <label>Tripping on mindcap</label>
        <description>I think I finally understand what silence is trying to say.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <!-- Peaking -->
      <li>
        <label>Tripping on mindcap</label>
        <description>I see the music and hear the colors.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

