      </li>
      <!-- Easing -->
      <li>
        <label>mindcap easing</label>
        <description>Placeholder description for RP_MindcapTripGoodMood easing stage.</description>
        <baseMoodEffect>25</baseMoodEffect>
      </li>
      <!-- Plateau -->
      <li>
        <label>mindcap plateau</label>
        <description>Placeholder description for RP_MindcapTripGoodMood plateau stage.</description>
