<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<!-- ============================================================
	     Dubs Bad Hygiene Compatibility
	     Adds ThirstRateMultiplier (tracks hungerRateFactor) and
	     BladderRateMultiplier (tracks restFallFactor) to all hediff
	     stages that reduce food/rest needs during trips.
	     ============================================================ -->

	<!-- ==================== LYS COME-UP ==================== -->

	<Operation Class="PatchOperationAdd" MayRequire="Dubwise.DubsBadHygiene">
		<xpath>/Defs/HediffDef[defName="RP_LYSComeUp"]/stages/li[label="unsettled"]</xpath>
		<value>
			<statOffsets>
				<ThirstRateMultiplier>0.5</ThirstRateMultiplier>
				<BladderRateMultiplier>0.3</BladderRateMultiplier>
			</statOffsets>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd" MayRequire="Dubwise.DubsBadHygiene">
		<xpath>/Defs/HediffDef[defName="RP_LYSComeUp"]/stages/li[label="ascending"]</xpath>
